# Copy to ".env" and adjust. NEVER commit the real .env.
# Default uses SQLite at ./data/app.db; uncomment to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aireader

# API keys accepted by the API (comma-separated). Empty = auth disabled.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
