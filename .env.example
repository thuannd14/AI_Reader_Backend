# Copy to ".env" and adjust. NEVER commit the real .env.
# Default uses SQLite at ./data/app.db; uncomment to use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aireader
#
# On Railway: add a PostgreSQL plugin and reference its DATABASE_URL.
# postgres:// and postgresql:// are auto-normalized to postgresql+psycopg://

# API keys accepted by the API (comma-separated). Empty = auth disabled.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production (Railway): ALWAYS set this on the Railway Variables UI — never commit real keys.
API_KEYS=

# Client-only: used by `python -m scripts.upload_railway` (local → Railway).
# Prefer setting in the shell:  $env:AIREADER_API_KEY="..."
# Do NOT commit a real value here.
# AIreader_API_KEY=

# AI chat — DeepSeek (OpenAI-compatible). Required for POST /chat.
# DEEPSEEK_API_KEY=
# Optional aliases / overrides:
# OPENAI_API_KEY=          # used if DEEPSEEK_API_KEY empty
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# CHAT_TIMEOUT_SECONDS=60
